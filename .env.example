# Copy this file to .env and fill in your keys.
# The app works without API keys in Browser + None-translation mode.

PORT=5001

# Required for OpenAI Whisper transcription and GPT-4o-mini translation
OPENAI_API_KEY=sk-...

# Required for AssemblyAI real-time transcription
ASSEMBLYAI_API_KEY=...

# Required for Claude Haiku translation
ANTHROPIC_API_KEY=sk-ant-...

# Inject artificial latency on API routes and WebSocket chunks to simulate
# mobile network conditions during local development (milliseconds).
# 0 = disabled. Recommended test value: 1500 (slow 4G + mobile CPU overhead).
SIMULATE_LATENCY_MS=0

# Python interpreter with mlx-whisper installed, used by the local "mlx"
# transcription provider (Apple Silicon only). Plain "python3" on PATH is
# usually NOT this interpreter if you installed mlx-whisper via conda/venv —
# point this at that interpreter explicitly. Leave unset to fall back to
# "python3" on PATH.
MLX_PYTHON=/opt/homebrew/Caskroom/miniconda/base/bin/python3

# Sermon mode's file-based glossary (server/lib/glossary-store.ts). Directory
# the server is allowed to read glossary CSV/md files from — this is a
# security boundary (server/lib/glossary-file.ts), not just a convenience
# path: whoever can write a file here can have its content embedded verbatim
# into the translation system prompt. Leave unset to default to <repo>/data.
GLOSSARY_DIR=./data

# Default glossary filenames (basenames only, resolved inside GLOSSARY_DIR)
# used at boot and whenever a request doesn't specify one. Leave unset to
# default to the filenames below.
GLOSSARY_CSV=preek_woordenlijst_NL_EN_1.csv
GLOSSARY_PROMPT=context_afhankelijke_termen_prompt_v2.md

# Sermon mode's Bible-quote pipeline (server/lib/scripture.ts). Directory the
# server reads the built verse data from (scripts/build-bible-data.ts ->
# sv-nl.json.gz, kjv-en.json.gz, books.json) — run that script once (or
# whenever the source Bible repos change) before this feature works. Leave
# unset to default to <repo>/data/bible.
BIBLE_DIR=./data/bible

# Preferred verse-text source for a verbatim reading — api.esv.org, free for
# non-commercial use with an API key (~5,000 queries/day). Verses are cached
# to disk (see ESV_CACHE_DIR below) so repeats don't re-hit the API. Leave
# unset to always use the bundled King James Version (public domain) instead
# — a client can also supply this per-request via Settings.
ESV_API_KEY=

# Where fetched ESV verses are cached on disk. Leave unset to default to
# <repo>/data/bible-cache/esv.
ESV_CACHE_DIR=./data/bible-cache/esv
